    "presentation": {
      "audience": "technical",
      "detail_level": "deep",
      "reader_goal": "Understand how a declared task becomes queued work, how workers and the scheduler coordinate execution, and how results, retries, and failures travel through the system.",
      "priorities": [
        "task lifecycle",
        "worker and scheduler responsibilities",
        "queue and result state",
        "retry and failure paths"
      ],
      "deemphasize": [
        "individual storage backend implementations",
        "framework integration examples",
        "administrative commands"
      ],
      "focus": [
        "runtime-flow",
        "state",
        "interfaces",
        "source-evidence"
      ]
    }
  },
  "system": {
    "name": "Huey Task Queue",
    "summary": "Huey is a lightweight task queue that allows developers to declare tasks via decorators, enqueue them for asynchronous execution, and manage results, retries, and failures through a coordinated system of workers and a scheduler."
  },
  "modules": [
    {
      "id": "api",
      "name": "API Layer",
      "responsibility": "Provides the public interface for declaring tasks, enqueuing them, and managing results and schedules.",
      "source_refs": [
        "src-api"
      ]
    },
    {
      "id": "registry",
      "name": "Task Registry",
      "responsibility": "Maintains a mapping of task names to task classes and handles serialization/deserialization of task messages.",
      "source_refs": [
        "src-registry"
      ]
    },
    {
      "id": "storage",
      "name": "Storage Backend",
      "responsibility": "Abstracts the underlying queue and result store, providing operations for enqueue, dequeue, schedule, and result retrieval.",
      "source_refs": [
        "src-storage"
      ]
    },
    {
      "id": "consumer",
      "name": "Consumer & Workers",
      "responsibility": "Runs the worker processes and scheduler that dequeue tasks, execute them, and manage retries and failures.",
      "source_refs": [
        "src-consumer"
      ]
    },
    {
      "id": "serializer",
      "name": "Serialization",
      "responsibility": "Handles serialization and deserialization of task messages, including optional compression and signing.",
      "source_refs": [
        "src-serializer"
      ]
    }
  ],
  "nodes": [
