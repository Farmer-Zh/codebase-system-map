      "reader_goal": "Understand how a declared task becomes queued work, how workers and the scheduler coordinate execution, and how results, retries, and failures travel through the system.",
      "priorities": [
        "task lifecycle",
        "worker and scheduler responsibilities",
        "queue and result state",
        "retry and failure paths"
      ],
      "deemphasize": [
        "individual storage backend implementations",
        "framework integration examples",
        "administrative commands"
      ]
    }
  },
  "system": {
    "name": "huey",
    "summary": "huey is a lightweight Python task queue. Decorated functions build serializable Task messages that are stored in a backend queue; a Consumer supervises Worker processes that dequeue and execute tasks and a Scheduler that moves delayed/periodic tasks into the queue. Results are retained in a key/value result store and fetched through Result handles, while the execution layer converts failures into retries or stored errors."
  },
  "modules": [
    {
      "id": "api",
      "name": "Task API and enqueue",
      "responsibility": "Declares tasks through decorators, builds Task objects, serializes and enqueues them, and exposes scheduling helpers and result handles.",
      "source_refs": [
        "s006",
        "s009",
        "s010",
        "s012",
        "s018",
        "s025",
        "s027"
      ]
    },
    {
      "id": "registry",
      "name": "Task registry, message codec, and serialization",
      "responsibility": "Registers task classes by qualified name, converts Task objects to/from flat Message tuples, and pickles them with optional compression or HMAC signing.",
      "source_refs": [
        "s055",
        "s057",
        "s058",
        "s059",
        "s060",
        "s061"
      ]
    },
    {
      "id": "storage",
      "name": "Storage backend contract",
      "responsibility": "Defines the backend APIs for the task queue, the delayed-task schedule, and the key/value result store; concrete backends implement these primitives.",
      "source_refs": [
        "s049",
        "s050",
        "s051",
        "s052"
      ]
    },
    {
      "id": "consumer",
      "name": "Consumer supervisor",
      "responsibility": "Creates the execution environment, starts and supervises scheduler and worker processes, and coordinates graceful shutdown.",
      "source_refs": [
        "s039",
        "s040",
        "s042",
        "s044",
        "s047"
      ]
    },
    {
      "id": "worker",
      "name": "Worker process",
      "responsibility": "Polls the queue and hands each dequeued task to the execution engine, backing off when the queue is empty.",
      "source_refs": [
        "s034",
        "s035"
      ]
    },
    {
      "id": "scheduler",
      "name": "Scheduler process",
      "responsibility": "Moves due scheduled tasks from the schedule store into the main queue and enqueues periodic tasks when their crontab matches.",
      "source_refs": [
        "s036",
        "s037"
      ]
    },
    {
      "id": "execution",
      "name": "Execution and retry handling",
      "responsibility": "Runs ready tasks, applies timeout context and pre/post execution hooks, and translates expected exceptions into retry state or failure metadata.",
      "source_refs": [
        "s015",
        "s016",
        "s017",
        "s018"
      ]
    },
    {
      "id": "results",
      "name": "Result handles",
      "responsibility": "Wraps task ids so callers can poll or block for stored results, and raises TaskException when a stored Error is retrieved.",
      "source_refs": [
        "s029",
        "s030",
        "s031"
      ]
    }
  ],
