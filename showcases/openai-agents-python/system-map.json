      "reader_goal": "Understand how an agent run turns instructions and user input into model decisions, tools, handoffs, guarded outputs, persisted context, and traces that both product and engineering teams can discuss.",
      "priorities": [
        "agent run loop",
        "instructions and handoff prompt effects",
        "tool execution",
        "handoffs",
        "input and output guardrails",
        "session continuity and tracing"
      ],
      "deemphasize": [
        "provider-specific adapters",
        "voice and realtime subsystems",
        "low-level streaming event bookkeeping",
        "sandbox implementation details"
      ]
    }
