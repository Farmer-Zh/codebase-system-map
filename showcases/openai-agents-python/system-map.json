  "system": {
    "name": "OpenAI Agents SDK",
    "summary": "A lightweight, provider-agnostic framework for building multi-agent workflows. It manages the agent run loop, tool execution, handoffs, guardrails, sessions, and tracing, turning instructions and user input into model decisions and final outputs."
  },
