{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Farmer-Zh/codebase-system-map/schemas/system-map.schema.json",
  "title": "Codebase System Map IR 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "system", "modules", "nodes", "edges", "sources", "prompts"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "repository", "analyzed_revision", "language"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "repository": { "type": "string", "minLength": 1 },
        "analyzed_revision": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/module" }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/prompt" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1 },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "detail_level", "focus"],
      "properties": {
        "audience": { "enum": ["product", "technical", "mixed"] },
        "detail_level": { "enum": ["overview", "standard", "deep"] },
        "reader_goal": { "$ref": "#/$defs/nonEmptyString" },
        "priorities": { "$ref": "#/$defs/stringList" },
        "deemphasize": { "$ref": "#/$defs/stringList" },
        "focus": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["capabilities", "prompts", "runtime-flow", "state", "interfaces", "source-evidence"] }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "responsibility", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "responsibility": { "$ref": "#/$defs/nonEmptyString" },
        "source_refs": { "$ref": "#/$defs/idList", "minItems": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module_id", "kind", "name", "purpose", "inputs", "outputs", "source_refs", "prompt_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "module_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["entry", "stage", "decision", "worker", "llm", "tool", "store", "external", "artifact", "output"] },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "source_refs": { "$ref": "#/$defs/idList", "minItems": 1 },
        "prompt_refs": { "$ref": "#/$defs/idList" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "label", "primary", "source_refs"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": { "enum": ["flow", "read", "write", "return", "dispatch", "feedback"] },
        "label": { "type": "string" },
        "primary": { "type": "boolean" },
        "source_refs": { "$ref": "#/$defs/idList", "minItems": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "start_line", "end_line", "evidence_kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "evidence_kind": { "enum": ["code", "documentation", "configuration", "prompt"] }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ref", "title", "excerpt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_ref": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "excerpt": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
